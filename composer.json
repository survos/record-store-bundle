{
    "name": "survos/record-store-bundle",
    "description": "Provider-neutral Symfony record stores for application-backed tables, with Grist support and adapter contracts.",
    "keywords": ["symfony", "grist", "quickbase", "records", "low-code"],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.6",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/test-pack": "^1.0"
    },
    "autoload": {"psr-4": {"Survos\\RecordStoreBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Survos\\RecordStoreBundle\\Tests\\": "tests/"}},
    "extra": {"symfony": {"require": "^8.1"}},
    "prefer-stable": true
}
